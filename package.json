{
  "name": "ccc-brand-mcp",
  "version": "0.9.0",
  "description": "Strict MCP server for Consumer Choice Center brand-guided design generation.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "ccc-brand-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "data",
    "assets",
    "scripts/smoke-test.mjs",
    "scripts/remote-smoke-test.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "check": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:http": "node scripts/remote-smoke-test.mjs",
    "audit:prod": "pnpm audit --prod",
    "render:samples": "pnpm run build && node scripts/generate-reference-variants.mjs",
    "render:social-set": "pnpm run build && node scripts/generate-social-template-set.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0",
    "nspell": "2.1.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.20.0",
    "@types/nspell": "2.1.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=11 <12"
  },
  "license": "UNLICENSED"
}
